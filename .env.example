# ─────────────────────────────────────────────────────────────
# Mukono Tigers SC — Environment Variables Template
# Copy this file to .env.local (never commit the real .env.local)
# ─────────────────────────────────────────────────────────────

# --- Database (Prisma) ---
# Provided by Supabase project settings > Database > Connection string
# Use the "connection pooling" URL for DATABASE_URL and the direct
# connection for DIRECT_URL (Prisma migrations need a non-pooled connection).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Supabase (Auth + Storage) ---
# Found in Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="⚠️ public anon key — safe for browser"
SUPABASE_SERVICE_ROLE_KEY="⚠️ SECRET — server-only, never expose to client"

# --- App ---
NEXT_PUBLIC_SITE_URL="https://www.mukonotigers.sc.ug" # ⚠️ confirm final domain
NEXT_PUBLIC_SITE_NAME="Mukono Tigers SC"

# --- Email (contact form / notifications) — provider TBD ---
# ⚠️ CLUB INPUT NEEDED: which transactional email provider (Resend, SendGrid, etc.)
EMAIL_FROM_ADDRESS="no-reply@mukonotigers.sc.ug"
EMAIL_PROVIDER_API_KEY=""

# --- Payments (Shop / Tickets / Membership) — provider TBD, see architecture §7.5 ---
# ⚠️ CLUB INPUT NEEDED: Flutterwave / Pesapal / Stripe / Mobile Money aggregator
PAYMENT_PROVIDER_PUBLIC_KEY=""
PAYMENT_PROVIDER_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# --- Analytics — provider TBD ---
# ⚠️ CLUB INPUT NEEDED: Google Analytics / Plausible preference
NEXT_PUBLIC_ANALYTICS_ID=""

# --- Search (if Meilisearch/Algolia chosen in Phase 5) ---
SEARCH_PROVIDER_API_KEY=""
SEARCH_PROVIDER_HOST=""
